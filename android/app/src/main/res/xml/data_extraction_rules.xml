<?xml version="1.0" encoding="utf-8"?>
<!--
  HWB stores encrypted clinical/PHI data on-device. Cloud backup and
  device-to-device transfer are fully excluded so no patient data leaves
  the device through those paths (Android 12+ / API 31).
  Ref: https://developer.android.com/guide/topics/data/autobackup
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>