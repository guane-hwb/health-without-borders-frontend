<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Core NFC will not start a tag session without this entitlement, no matter
	  what the code does. "TAG" covers the raw tag sessions HWB uses to read
	  NTAG wristbands and guardian cards; "NDEF" is not sufficient on its own
	  because we need the chip identifier, not only its NDEF message.

	  This file is only half of the requirement: the App ID in the Apple
	  Developer portal must also have the NFC Tag Reading capability enabled,
	  and the provisioning profile must be regenerated afterwards. That part
	  cannot be done from the repository.
	-->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
		<string>NDEF</string>
	</array>
</dict>
</plist>
