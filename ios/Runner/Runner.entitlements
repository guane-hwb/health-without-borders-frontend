<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Core NFC will not start a tag session without this entitlement, no matter
	  what the code does. "TAG" covers the raw tag sessions HWB uses
	  (NFCTagReaderSession, the only kind nfc_manager opens): they give the chip
	  identifier and read the NDEF message of patient and caregiver devices.

	  Only "TAG". App Store Connect rejects "NDEF" in this list for builds made
	  with a current SDK ("Invalid entitlement for core nfc framework ... 'NDEF
	  is disallowed'"), so a build that declares it cannot reach TestFlight or
	  the App Store. HWB never opens an NFCNDEFReaderSession, so nothing uses it.

	  This file is only half of the requirement: the App ID in the Apple
	  Developer portal must also have the NFC Tag Reading capability enabled,
	  and the provisioning profile must be regenerated afterwards. That part
	  cannot be done from the repository.
	-->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
